{
  "manifest_version": 3,
  "name": "Smooth Surfer",
  "version": "0.2.14",
  "description": "Filter distracting feeds, add loading delays to habitual sites, and share pinned tabs across Chrome windows.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "offscreen"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "toggle-pin-tab": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Command+Shift+P"
      },
      "description": "Pin or unpin the current tab"
    }
  },
  "action": {
    "default_title": "Smooth Surfer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["src/theme.css", "src/styles.css"],
      "js": ["src/settings.js", "src/storage.js", "src/visit-delay.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/feedback.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "optional_permissions": ["tabs"]
}
